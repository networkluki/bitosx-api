<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Development-only helper for the local live stack (tools/devstack/mail.sh): prints the token carried by the
    latest pending email_outbox message for an address. It is a separate tool, never part of the API's publish
    output, and refuses to run unless the environment is Development or Testing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BitosX.Infrastructure\BitosX.Infrastructure.csproj" />
  </ItemGroup>

</Project>
