{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "127.0.0.1;localhost;api.bitosx.se",
  "Security": {
    "Cors": {
      "AllowedOrigins": "https://vault.bitosx.se",
      "StatusPageOrigins": "https://bitosx.se",
      "PreflightMaxAgeSeconds": 600
    },
    "WebAuthn": {
      "RelyingPartyId": "vault.bitosx.se",
      "RelyingPartyName": "BitosX",
      "Origins": [ "https://vault.bitosx.se" ]
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5080"
      }
    }
  }
}
