<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BitosX.Application\BitosX.Application.csproj" />
    <ProjectReference Include="..\BitosX.Contracts\BitosX.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Fido2" Version="4.3.2" />
    <!-- Fido2 4.3.2 (the latest stable) asks for System.Formats.Cbor 9.0.0, which has
         GHSA-vmv3-wvjp-wqpj (CVE-2026-118747): CBOR map keys chosen to collide make the
         duplicate-key check slow. The attestation object of a passkey registration is CBOR
         from the client. Referenced directly so that the patched version is the one used;
         remove when a Fido2 release asks for a patched version itself. -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
